# Nebula AI Core 环境变量示例（复制为 .env 后修改）
# 作者: 晨星
# 所有变量均以 NEBULA_ 前缀覆盖；未设置时使用默认值（零依赖离线后端）

# 后端选型
NEBULA_EMBEDDER=hash
NEBULA_VECTOR_STORE=memory
NEBULA_LEXICAL=bm25
NEBULA_LLM=deterministic
NEBULA_RERANKER=score

# 分块参数
NEBULA_CHUNK_SIZE=400
NEBULA_CHUNK_OVERLAP=80
NEBULA_TOP_K=5
NEBULA_EMBED_DIM=256

# 生产后端配置（启用对应后端后再填）
NEBULA_FASTEMBED_MODEL=BAAI/bge-small-en-v1.5
NEBULA_LLAMACPP_MODEL_PATH=
NEBULA_OPENAI_BASE_URL=http://localhost:11434/v1
NEBULA_OPENAI_API_KEY=sk-no-key
NEBULA_OPENAI_MODEL=qwen2

# 日志级别
NEBULA_LOG_LEVEL=INFO
